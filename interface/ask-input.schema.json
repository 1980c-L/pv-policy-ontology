{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:newenergy-ontology:ask:v1:input",
  "title": "ask/v1 input",
  "description": "单条请求对象，或请求对象数组（批量，按顺序返回）。",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/request"
      }
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": [
            "object",
            "null"
          ]
        },
        "policy_as_of": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "top_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 20
        },
        "request_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
