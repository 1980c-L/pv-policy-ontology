{"entity_id": "O-E-004", "label": "一般工商业分布式光伏", "class": "project_type", "aliases": ["一般工商业"], "definition": "利用党政机关、学校、医院、市政、文化、体育设施、交通场站等公共机构以及工商业厂房等建筑物及其附属场所建设，与公共电网连接点电压等级不超过10千伏（20千伏）、总装机容量原则上不超过6兆瓦的分布式光伏。", "source_refs": [{"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第四条", "kind": "clause", "value": "第四条", "quote": "一般工商业分布式光伏是指利用党政机关、学校、医院、市政、文化、体育设施", "evidence_level": "normative"}], "temporal_scope": {"effective_from": "2025-01-23", "effective_to": null}}
{"entity_id": "O-E-005", "label": "大型工商业分布式光伏", "class": "project_type", "aliases": ["大型工商业"], "definition": "利用建筑物及其附属场所建设，接入用户侧电网或者与用户开展专线供电（不直接接入公共电网且用户与发电项目投资方为同一法人主体），与公共电网连接点电压等级为35千伏、总装机容量原则上不超过20兆瓦，或电压等级为110千伏（66千伏）、总装机容量原则上不超过50兆瓦的分布式光伏。", "source_refs": [{"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第四条", "kind": "clause", "value": "第四条", "quote": "大型工商业分布式光伏是指利用建筑物及其附属场所建设", "evidence_level": "normative"}], "temporal_scope": {"effective_from": "2025-01-23", "effective_to": null}}
{"entity_id": "O-E-006", "label": "分布式光伏上网模式", "class": "policy_concept", "aliases": ["上网模式"], "definition": "全额上网、全部自发自用、自发自用余电上网三种。", "source_refs": [{"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第五条", "kind": "clause", "value": "第五条", "quote": "分布式光伏发电上网模式包括全额上网、全部自发自用、自发自用余电上网三种", "evidence_level": "normative"}], "temporal_scope": {"effective_from": "2025-01-23", "effective_to": null}}
{"entity_id": "O-E-007", "label": "新老划断", "class": "policy_concept", "aliases": ["新老政策衔接"], "definition": "对办法发布之日前已备案、且于2025年5月1日前并网投产的项目，仍按原有政策执行。", "source_refs": [{"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第四十三条", "kind": "clause", "value": "第四十三条", "quote": "对于本办法发布之日前已备案且于2025年5月1日前并网投产的分布式光伏发电项目", "evidence_level": "normative"}, {"source_id": "PV-EXPLAIN-20250123", "locator_id": "PV-EXPLAIN-20250123#section=四(一)", "kind": "section", "value": "四(一)", "quote": "对于本办法发布之日前已备案且于2025年5月1日前并网投产的分布式光伏发电项目", "evidence_level": "official_explanation"}], "temporal_scope": {"effective_from": "2025-01-23", "effective_to": null}}
