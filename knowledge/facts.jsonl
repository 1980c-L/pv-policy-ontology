{"fact_id": "O-F-001", "relation": "classification_scheme", "statement": "分布式光伏发电分为自然人户用、非自然人户用、一般工商业和大型工商业四种类型，分类要素为建设场所、接入电压等级和装机容量。", "claim_status": "supported", "source_refs": [{"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第四条", "kind": "clause", "value": "第四条", "quote": "分布式光伏发电分为自然人户用、非自然人户用、一般工商业和大型工商业四种类型", "evidence_level": "normative"}, {"source_id": "PV-EXPLAIN-20250123", "locator_id": "PV-EXPLAIN-20250123#section=三(一)", "kind": "section", "value": "三(一)", "quote": "细分为自然人户用、非自然人户用、一般工商业、大型工商业四种类型", "evidence_level": "official_explanation"}], "temporal_scope": {"effective_from": "2025-01-23", "effective_to": null}}
{"fact_id": "O-F-002", "relation": "date_semantics", "statement": "《管理办法》第四十三条的“发布之日”指对全社会公布日期 2025年1月23日；1月23日当日备案也属于“发布之日前已备案”。", "claim_status": "supported", "source_refs": [{"source_id": "PV-FAQ-20250411", "locator_id": "PV-FAQ-20250411#qa=Q71", "kind": "qa", "value": "Q71", "quote": "“发布之日”指《管理办法》对全社会公布日期即2025年1月23日", "evidence_level": "official_qa"}, {"source_id": "PV-FAQ-20250411", "locator_id": "PV-FAQ-20250411#qa=Q71", "kind": "qa", "value": "Q71", "quote": "1月23日当日备案的也属于发布之日前已备案项目", "evidence_level": "official_qa"}], "temporal_scope": {"effective_from": "2025-01-23", "effective_to": null}}
{"fact_id": "O-F-003", "relation": "date_semantics", "statement": "2025年5月1日前（含当日）并网指分布式光伏发电项目全容量并网；部分容量并网的不能按原政策执行。", "claim_status": "supported", "source_refs": [{"source_id": "PV-FAQ-20250411", "locator_id": "PV-FAQ-20250411#qa=Q72", "kind": "qa", "value": "Q72", "quote": "2025年5月1日前（含当日）并网是指分布式光伏发电项目全容量并网", "evidence_level": "official_qa"}, {"source_id": "PV-FAQ-20250411", "locator_id": "PV-FAQ-20250411#qa=Q72", "kind": "qa", "value": "Q72", "quote": "对于部分容量并网的，不能按照原政策执行", "evidence_level": "official_qa"}], "temporal_scope": {"effective_from": "2025-01-23", "effective_to": null}}
{"fact_id": "O-F-004", "relation": "grid_mode_rule", "statement": "自然人户用、非自然人户用可在三种上网模式中三选一；一般工商业只能选全部自发自用或自发自用余电上网；大型工商业原则上全部自发自用，电力现货市场连续运行地区可采用自发自用余电上网参与现货市场。", "claim_status": "supported", "source_refs": [{"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第五条", "kind": "clause", "value": "第五条", "quote": "一般工商业分布式光伏可选择全部自发自用或者自发自用余电上网模式", "evidence_level": "normative"}, {"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第五条", "kind": "clause", "value": "第五条", "quote": "大型工商业分布式光伏原则上选择全部自发自用模式", "evidence_level": "normative"}, {"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第五条", "kind": "clause", "value": "第五条", "quote": "大型工商业分布式光伏可采用自发自用余电上网模式参与现货市场", "evidence_level": "normative"}], "temporal_scope": {"effective_from": "2025-01-23", "effective_to": null}}
{"fact_id": "O-F-005", "relation": "definition", "statement": "分布式光伏发电项目的容量为交流侧容量，即逆变器额定输出功率之和。", "claim_status": "supported", "source_refs": [{"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第十三条", "kind": "clause", "value": "第十三条", "quote": "分布式光伏发电项目的容量为交流侧容量（即逆变器额定输出功率之和）", "evidence_level": "normative"}], "temporal_scope": {"effective_from": "2025-01-23", "effective_to": null}}
