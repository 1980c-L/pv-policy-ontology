{"record_id": "O-R-002", "record_type": "rule", "text": "分布式光伏上网模式判定（按项目类型）", "entity_ids": [], "fact_ids": [], "rule_ids": ["O-R-002"], "source_refs": [{"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第五条", "kind": "clause", "value": "第五条", "quote": "分布式光伏发电上网模式包括全额上网、全部自发自用、自发自用余电上网三种", "evidence_level": "normative"}, {"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第五条", "kind": "clause", "value": "第五条", "quote": "自然人户用、非自然人户用分布式光伏可选择全额上网", "evidence_level": "normative"}, {"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第五条", "kind": "clause", "value": "第五条", "quote": "一般工商业分布式光伏可选择全部自发自用或者自发自用余电上网模式", "evidence_level": "normative"}, {"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第五条", "kind": "clause", "value": "第五条", "quote": "大型工商业分布式光伏原则上选择全部自发自用模式", "evidence_level": "normative"}, {"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第五条", "kind": "clause", "value": "第五条", "quote": "大型工商业分布式光伏可采用自发自用余电上网模式参与现货市场", "evidence_level": "normative"}, {"source_id": "PV-NAT-2025-007-ATTACH", "locator_id": "PV-NAT-2025-007-ATTACH#clause=第五条", "kind": "clause", "value": "第五条", "quote": "涉及自发自用的，用户和分布式光伏发电项目应位于同一用地红线范围内", "evidence_level": "normative"}, {"source_id": "PV-ZJ-2026-015", "locator_id": "PV-ZJ-2026-015#clause=第四条", "kind": "clause", "value": "第四条", "quote": "大型工商业分布式光伏可选择全部自发自用或者自发自用余电上网", "evidence_level": "normative"}, {"source_id": "PV-EXPLAIN-20250123", "locator_id": "PV-EXPLAIN-20250123#section=三(一)", "kind": "section", "value": "三(一)", "quote": "一般工商业可在全部自发自用和自发自用余电上网模式中二选一", "evidence_level": "official_explanation"}, {"source_id": "PV-FAQ-20250411", "locator_id": "PV-FAQ-20250411#qa=Q5", "kind": "qa", "value": "Q5", "quote": "一般工商业分布式光伏与公共电网连接点电压等级不超过10千伏（20千伏）", "evidence_level": "official_qa"}], "conditions": [{"case_id": "household_three_modes", "when": {"logic": "all", "c